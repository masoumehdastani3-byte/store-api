@section scripts {
<script>
    function send() {
        if (typeof jQuery === "undefined") {
            alert("jQuery لود نشده است");
            return;
        }
        var Data = $("#form_Submit").serialize();
        $.ajax({
            traditional: true,
            type: "Post",
            url: "http://torob.farshdastani.ir/api/products/post",
            dataType: "html",
            data: Data,
            success: function (response) {
                alert(response);
                $("#form_View").html(response);
            },
            error: function (ex) {
                alert(ex.responseText);
            }
        });
    }
</script>
}
